# API Settings
SECRET_KEY=your-secret-key-here-make-it-long-and-random
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Supabase Settings
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# External APIs
GOOGLE_CLOUD_VISION_API_KEY=your-google-vision-key
GOOGLE_CLOUD_PROJECT_ID=your-google-project-id
FASHION_AI_API_KEY=your-fashion-ai-key
FASHION_AI_BASE_URL=https://api.fashionai.com/v1
OPENWEATHER_API_KEY=your-openweather-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
GOOGLE_PLACES_API_KEY=your-google-places-key
GOOGLE_PLACES_BASE_URL=https://maps.googleapis.com/maps/api/place
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Redis Settings
REDIS_URL=redis://localhost:6379

# Rate Limiting
GOOGLE_VISION_RATE_LIMIT=1000
FASHION_AI_RATE_LIMIT=100
OPENWEATHER_RATE_LIMIT=1000
GOOGLE_PLACES_RATE_LIMIT=100

# Image Processing
MAX_IMAGE_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]

# Cache Settings
CACHE_TTL_WEATHER=3600
CACHE_TTL_PLACES=86400
CACHE_TTL_TRENDS=3600
