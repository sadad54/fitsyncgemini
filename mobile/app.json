{
  "expo": {
    "name": "Flairwise",
    "slug": "flairwise",
    "scheme": "flairwise",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flairwise uses your photos to add clothing items to your closet.",
          "cameraPermission": "Flairwise uses your camera to capture clothing items."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flairwise uses your location once to make outfit suggestions appropriate for the current weather."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Flairwise can use Face ID to protect your local style session."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:8000"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "backgroundColor": "#F6F6F2",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}